<Window x:Class="SPO_Lab2a.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Анализатор метрик Джилба (C++)" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Введите код C++:" FontWeight="Bold" Margin="0,0,0,5"/>

        <TextBox Grid.Row="1" x:Name="CodeTextBox"
                 FontFamily="Consolas" FontSize="12"
                 AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,5">
            <Button x:Name="AnalyzeButton" Content="Анализировать"
                    Width="150" Height="30" Margin="0,0,10,0"
                    Click="AnalyzeButton_Click"/>
            <Button x:Name="LoadFileButton" Content="Загрузить из файла"
                    Width="150" Height="30"
                    Click="LoadFileButton_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="3" Header="Результаты" Padding="10">
            <StackPanel>
                <TextBlock x:Name="ResultCL" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="ResultCl" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="ResultCLI" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="ResultTotal" FontSize="14"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>